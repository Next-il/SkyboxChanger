<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 and CounterStrikeSharp.API 1.0.374 are PanoramaManager's floor. The package drives the
         HUD entity through the CCSCustomHudLayout API that release added and declares the dependency,
         so a lower pin below fails restore with NU1605 - and the server needs 1.0.374 as well. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SkyboxChanger</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BaseOutputPath>build\addons\counterstrikesharp\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)plugins\SkyboxChanger\</OutputPath>
    <GameDataPath>$(BaseOutputPath)gamedata\</GameDataPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374">
      <IncludeAssets>compile</IncludeAssets>
    </PackageReference>
    <Reference Include="MenuManagerApi"><HintPath>MenuManagerApi.dll</HintPath></Reference>

    <!-- From nuget.org, copied next to the plugin by CopyPanoramaManager below: each CounterStrikeSharp
         plugin loads through a context that probes its own folder, and each gets its own Panorama
         statics. A second copy of a SHARED api dll next to the plugin is what breaks capability casts -
         this one is not shared, so it belongs here. -->
    <PackageReference Include="PanoramaManager" Version="0.4.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MySQLConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <LangFiles Include="lang/*.*" />
    <GameDataFiles Include="gamedata/*.*" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
		<Copy SourceFiles="@(LangFiles)" DestinationFolder="$(OutputPath)\lang" />
		<Copy SourceFiles="@(GameDataFiles)" DestinationFolder="$(GameDataPath)" />
    <Copy SourceFiles="$(NuGetPackageRoot)\dapper\2.1.35\lib\net7.0\Dapper.dll" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="$(NuGetPackageRoot)\mysqlconnector\2.4.0\lib\net8.0\MySqlConnector.dll" DestinationFolder="$(OutputPath)" />
	</Target>

  <!-- CopyLocalLockFileAssemblies is off, so package dlls are not copied beside the plugin on build -
       Dapper and MySqlConnector are copied by hand in PostBuild above. This copies PanoramaManager's and
       nothing else; turning the property on would also bring MySqlConnector's Microsoft.Extensions
       abstractions, which the host already provides. -->
  <Target Name="CopyPanoramaManager" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)"
                               Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'PanoramaManager'" />
    </ItemGroup>
  </Target>

</Project>
